SECRET_KEY=
DATABASE=instance/goodware.db
COOKIE_SECURE=0
ALLOW_REGISTRATION=1
DAILY_LIMIT=100
PORT=5000
# Endpoint compatível com Chat Completions; exemplo de servidor local:
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=
LLM_API_KEY=
# Pickle pode executar código durante carregamento. Só habilite após validar procedência.
TRUST_MODEL_PICKLE=0
# Produção: PostgreSQL obrigatório; mantenha senhas fora do Git.
APP_ENV=development
DATABASE_URL=
PUBLIC_BASE_URL=http://127.0.0.1:5000
TRUST_PROXY=0
EMAIL_VERIFICATION_REQUIRED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Apenas para o compose: use segredo alfanumérico longo para evitar URL encoding.
POSTGRES_PASSWORD=
GOODWARE_DOMAIN=

# VirusTotal v3: chave privada, somente no servidor
VIRUSTOTAL_API_KEY=

# E-mail via HTTPS (alternativa ao SMTP em hospedagens que bloqueiam SMTP)
# Ative apenas após configurar chave privada e remetente verificado.
MAIL_PROVIDER=smtp
RESEND_API_KEY=
MAIL_FROM=

# Envio pelo próprio Gmail do dono da conta (OAuth, somente no servidor)
# Requer Gmail API + autorização OAuth com escopo gmail.send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
